{
  "manifest_version": 3,
  "name": "整页截图 · 滚动归档",
  "version": "2.2.4",
  "minimum_chrome_version": "125",
  "description": "F12 原版整页截图与自动滚动归档，支持连续长图、PDF 和收藏总览。",
  "homepage_url": "https://github.com/firmamento73/Chorme-Full-Page-Shot",
  "author": "firmamento73",
  "permissions": [
    "activeTab",
    "scripting",
    "debugger",
    "storage",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "整页截图 · 滚动归档",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "打开网页归档面板"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self'; img-src 'self' blob: data:;"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  }
}
